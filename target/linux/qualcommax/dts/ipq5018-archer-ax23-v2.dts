// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Device tree for TP-Link Archer AX23 v2
 *
 * SoC:    Qualcomm IPQ5018 (IPQ0509), Cortex-A53 dual-core
 * RAM:    256 MB DDR3 (CDT: AP-MP02.1_128M16_DDR3_LM256)
 * Flash:  SPI-NAND 128 MB, dual-image (rootfs + rootfs_1)
 * Switch: Realtek RTL8367 family D (chip ID 0x6642 per qca-ssdk.ko
 *         analysis; NOT yet read from the physical unit)
 *         Trunk on GMAC1 -> UNIPHY0 -> CPU port 6, reset GPIO39.
 *         Trunk mode is HSGMII 2.5G -- see the note above &gmac1.
 *         Matches the stock running.dts forced-speed and physical
 *         clock measurement. UNVERIFIED on hardware (no UART yet).
 * WiFi:   IPQ5018 internal (ath11k) 2.4 GHz
 *         QCN6102 (qcn6122 fw) 5 GHz via PCIe
 * UART:   GPIO28 (RX) / GPIO29 (TX), 115200 8N1, 1.8V
 *         Header JP1 — level-shifter SMDs removed by TP-Link
 *
 * Hardware confirmed via:
 *   - GPL source analysis (GPL_AX23v2.tar.gz)
 *   - OEM firmware 1.1.2 rootfs extraction + decryption
 *   - Stock kernel module analysis (qca-ssdk.ko ELF/L2P table/SerDes)
 *   - U-Boot DTB ax23_mp02.1.dtb extracted from kernel FIT image
 *   - OEM U-Boot DTB and UART logs reported by community member vram
 *     (physical hardware access, not this project's own) -- OpenWrt forum
 *     thread t/249493, see docs/HARDWARE.md and docs/CREDITS.md
 *   - partition_config/partition-table from rootfs
 *   - Physical clock measurement on live stock hardware (root shell via
 *     disclosed LuCI vulnerability, see docs/KNOWN-ISSUES.md): stock
 *     running.dts has forced-speed = <0x9c4> (2500) on ess-switch port@1;
 *     /sys/kernel/debug/clk/clk_summary reads gcc_uniphy_tx_clk,
 *     gcc_uniphy_rx_clk, gcc_gmac1_tx_clk, gcc_gmac1_rx_clk all at
 *     312,500,000 Hz, which matches HSGMII 2500Base-X line rate
 *     (312.5 MHz x 10-bit 8b/10b = 3.125 Gbps) and does not match
 *     SGMII 1G (which would read 125 MHz)
 *   - Switch reset GPIO read directly from the live device tree on real
 *     hardware (root shell): /proc/device-tree/soc/ess-instance/
 *     ess-switch1@1/reset_gpio = 0x27 (GPIO39). This supersedes the
 *     earlier GPIO33 assumption, which traced back to a UART boot log
 *     from a different physical unit (community member vram), not a
 *     direct reading of this device. GPIO33 is confirmed to be the
 *     2.4GHz LED, with no reset function
 *   - LED polarity and full 7-LED map confirmed 2026-11-12 by reading
 *     the live device tree runtime on stock hardware (root shell):
 *     /proc/device-tree/soc/leds/<name>/gpios for all 7 LEDs shows the
 *     GPIO_ACTIVE_LOW flag bit absent (flags field = 0) in every case,
 *     i.e. all 7 are GPIO_ACTIVE_HIGH per the gpio-specifier binding,
 *     not active-low as an earlier pass concluded from visual
 *     inspection alone. That earlier conclusion was wrong and is
 *     corrected here after community member Veraxis reported the
 *     power LED staying off in two separate hardware tests (v0.2 and
 *     v0.3 on an AX21 v5 identifying as this model).
 *     Still unverified: the phy0tpt/phy1tpt trigger assignment on the
 *     two WiFi LEDs below remains an inference from registration
 *     order, not confirmed against real phy0/phy1 enumeration. The
 *     polarity fix here does not touch or validate that assumption.
 */

/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/net/qca-uniphy.h>

/ {
	model = "TP-Link Archer AX23 v2";
	compatible = "tplink,archer-ax23-v2", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		ethernet1 = &gmac1;
		label-mac-device = <&gmac1>;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 14 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_power: led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led-wan-orange {
			label = "amber:wan";
			gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
		};

		led-wan {
			label = "white:wan";
			gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
		};

		led-wps {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		};

		led-lan {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};

		led-wifi-5g {
			label = "white:wlan5g";
			gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "phy0tpt";
		};

		/*
		 * phy1tpt is inferred, not boot-tested: &wifi (2.4GHz)
		 * is registered before &wifi1 (5GHz) in this DTS, and
		 * the 5GHz LED above already uses phy0tpt, so phy1 is
		 * assumed to map to the 2.4GHz radio by registration
		 * order. Confirm against actual phy0/phy1 enumeration
		 * on first real boot with both radios up.
		 */
		led-wifi-2g {
			label = "white:wlan2g";
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "phy1tpt";
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&crypto { status = "okay"; };
&cryptobam { status = "okay"; };
&prng { status = "okay"; };
&qfprom { status = "okay"; };
&qpic_bam { status = "okay"; };
&watchdog { status = "okay"; };

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&serial_pins>;
	pinctrl-names = "default";
};

&gmac0 {
	status = "disabled";
};

/*
 * Trunk mode (GMAC1 <-> RTL8367 CPU port 6): HSGMII 2.5G.
 *
 * This device has five 1G physical ports (WAN + LAN1-4); no single
 * physical port on this SKU exceeds 1G. An earlier revision of this
 * DTS used that fact to argue for SGMII 1G instead, reasoning that
 * MODE_EXT_HSGMII / PORT_SPEED_2500M in the vendor U-Boot
 * (ipq5018_gmac.c, rtl8367_sw_init()) was generic SDK boilerplate
 * rather than a deliberate per-board choice, since that routine runs
 * unconditionally for any board with CONFIG_TP_EXT_SWITCH_RTL8367_ALL.
 *
 * That reasoning has been superseded by direct physical measurement.
 * The stock kernel's running.dts (the config that actually governs
 * runtime behaviour, not U-Boot's early generic bring-up) sets
 * forced-speed = <0x9c4> (2500) on this port, and reading
 * /sys/kernel/debug/clk/clk_summary on live stock hardware shows the
 * UNIPHY/GMAC1 tx and rx clocks locked at 312,500,000 Hz -- the exact
 * rate for HSGMII 2500Base-X (312.5 MHz x 10-bit = 3.125 Gbps line
 * rate), not SGMII 1G (which would be 125 MHz). This is a measurement
 * of the running system, not an interpretation of static firmware.
 *
 * Why the OEM would run HSGMII with no single port above 1G is not
 * fully confirmed: the working theory is that aggregate throughput
 * across WAN + LAN + 2.4GHz/5GHz WiFi (estimated ~1.75-1.8 Gbps) can
 * exceed what a 1G trunk allows even though no individual port does,
 * and since there is no native "1.8G" electrical mode on this
 * SerDes/switch, HSGMII 2.5G was the only mode that covers it. This
 * throughput estimate has not been measured or confirmed, and is
 * noted here as the leading hypothesis, not a proven fact.
 *
 * Driver support: patches 777-07/777-08 in this tree already carry
 * rtl8365mb_d_sds_jam_hsgmii (family D HSGMII tuning table) and the
 * RTL8365MB_D_SDS_MISC_MODE_HSGMII (0x12) path for
 * PHY_INTERFACE_MODE_2500BASEX. Upstream precedent: ipq5018-archer-
 * ax55-v1.dts (same IPQ5018 + RTL8367S + GPIO33 reset topology) uses
 * this same phy-mode/speed/refclk combination.
 *
 * STILL UNVERIFIED on physical hardware (no UART console available
 * for this build): clock measurement confirms the stock kernel's
 * configuration, not that this kernel (6.x, DSA, patches 777-0x) will
 * bring the link up and pass traffic cleanly. If the trunk does not
 * come up, SGMII 1G (the configuration this DTS used before this
 * change) is the fallback to try.
 *
 * pause is set on both fixed-link nodes below (gmac1 and the switch's
 * port@6). This trunk aggregates five 1G physical ports (plus WiFi)
 * onto a single 2.5G link, the same over-subscription scenario a
 * third party measured elsewhere causing roughly 13% UDP loss without
 * pause when the switch could not backpressure the 2.5G GMAC against
 * slower physical ports. Whether this tree's family D driver patches
 * (777-07/777-08) actually program the pause bits for this path has
 * not been independently re-verified alongside this change.
 */
&gmac1 {
	status = "okay";
	phy-mode = "2500base-x";

	fixed-link {
		speed = <2500>;
		full-duplex;
		pause;
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	switch@1d {
		compatible = "realtek,rtl8365mb";
		reg = <29>;

		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			ax23_phy0: ethernet-phy@0 {
				reg = <0>;
			};

			ax23_phy1: ethernet-phy@1 {
				reg = <1>;
			};

			ax23_phy2: ethernet-phy@2 {
				reg = <2>;
			};

			ax23_phy3: ethernet-phy@3 {
				reg = <3>;
			};

			ax23_phy4: ethernet-phy@4 {
				reg = <4>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "wan";
				phy-handle = <&ax23_phy0>;
			};

			port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&ax23_phy1>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&ax23_phy2>;
			};

			port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&ax23_phy3>;
			};

			port@4 {
				reg = <4>;
				label = "lan4";
				phy-handle = <&ax23_phy4>;
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac1>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
					pause;
				};
			};
		};
	};
};

&q6v5_wcss {
	boot-args = <0x2 0x4 0x2 0x1b 0x0 0x0>;
};

&wifi {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "TP-Link-Archer-AX23-v2";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "TP-Link-Archer-AX23-v2";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};

&blsp1_spi1 {
	status = "disabled";
};

&qpic_nand {
	status = "okay";
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x000000 0x080000>;
				read-only;
			};

			partition@80000 {
				label = "0:MIBIB";
				reg = <0x080000 0x080000>;
				read-only;
			};

			partition@100000 {
				label = "0:BOOTCONFIG";
				reg = <0x100000 0x040000>;
				read-only;
			};

			partition@140000 {
				label = "0:BOOTCONFIG1";
				reg = <0x140000 0x040000>;
				read-only;
			};

			partition@180000 {
				label = "0:QSEE";
				reg = <0x180000 0x100000>;
				read-only;
			};

			partition@280000 {
				label = "0:DEVCFG";
				reg = <0x280000 0x040000>;
				read-only;
			};

			partition@2c0000 {
				label = "0:CDT";
				reg = <0x2c0000 0x040000>;
				read-only;
			};

			partition@300000 {
				label = "0:APPSBLENV";
				reg = <0x300000 0x080000>;
			};

			partition@380000 {
				label = "0:APPSBL";
				reg = <0x380000 0x140000>;
				read-only;
			};

			partition@4c0000 {
				label = "0:ART";
				reg = <0x4c0000 0x100000>;
				read-only;
			};

			partition@5c0000 {
				label = "0:TRAINING";
				reg = <0x5c0000 0x080000>;
				read-only;
			};

			partition@640000 {
				label = "rootfs";
				reg = <0x640000 0x3580000>;
			};

			partition@3bc0000 {
				label = "rootfs_1";
				reg = <0x3bc0000 0x3580000>;
			};

			partition@7140000 {
				label = "tp_data";
				reg = <0x7140000 0x840000>;
				read-only;
			};

			partition@7980000 {
				label = "radio";
				reg = <0x7980000 0x440000>;
				read-only;
			};

			partition@7dc0000 {
				label = "data";
				reg = <0x7dc0000 0x080000>;
			};
		};
	};
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio14";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio10", "gpio11", "gpio12", "gpio13",
		       "gpio22", "gpio32", "gpio33";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio1-pins {
		mdc {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		mdio {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-pins {
		data {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-pull-up;
		};
		cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-pull-up;
		};
		clk {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	serial_pins: serial-pins {
		tx-pins {
			pins = "gpio29";
			function = "blsp0_uart1";
			drive-strength = <8>;
			bias-disable;
		};
		rx-pins {
			pins = "gpio28";
			function = "blsp0_uart1";
			drive-strength = <8>;
			bias-disable;
		};
	};
};
